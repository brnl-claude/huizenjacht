<?xml version="1.0" encoding="utf-8"?>
<!-- SetupActivity: the address of your Huizenjacht server. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/themeColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setupTitle"
            android:textColor="@color/textColor"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setupIntro"
            android:textColor="@color/textColor"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/setupUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:autofillHints="url"
            android:hint="@string/setupHint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:singleLine="true"
            android:textColor="@color/textColor"
            android:textColorHint="@color/mutedText" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/mutedText"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/setupConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="@string/setupConnect"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/setupUseAnyway"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setupUseAnyway"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setupNote"
            android:textColor="@color/mutedText"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
